    @pytest.mark.parametrize("field,value", [
        ("status", "incomplete"), ("error", {"message": "RAW_ERROR_PROMPT_SENTINEL"}),
        ("incomplete_details", {"reason": "max_output_tokens"}), ("model", "unknown-model"),
        ("service_tier", "priority"), ("usage", None), ("output", []),
